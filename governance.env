# governance.env — project-specific knobs read by scripts/guardrails and scripts/planning.
# Sourced by bash scripts and parsed by python scripts (KEY="value", one per line, no expansion).
# Keeping these here (not hardcoded in scripts) is what keeps the governance layer portable.

# Sensitive decision domains: a PD with one of these Sensitivity values never closes as
# DEFAULT_APPLIED without explicit ratification (decision-index.py hard gate).
SENSITIVE_DOMAINS="tenant-isolation security billing privacy public-api schema"

# Extended regex over diff paths that puts a story at rigor level N2 (next-tasks.py, review-gate).
SENSITIVE_PATHS="(migrations?/|/auth|/security|/billing|/privacy|/tenant|openapi|\.proto$)"

# Normative files measured by instruction-budget.sh (space-separated).
BUDGET_FILES="CLAUDE.md AGENTS.md"

# Branch names for the two-hop flow.
MAIN_BRANCH="main"
DEVELOP_BRANCH="develop"

# The person (or role) who ratifies decisions.
DECIDER="{{DECIDER}}"
